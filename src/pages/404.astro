---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Not found">
  <h1>Not found</h1>
  <p class="prose" style="margin-top:1rem">That page doesn’t exist.</p>
  <div class="links"><a href={`${base}/` || '/'}>Back to About</a></div>
</Base>
